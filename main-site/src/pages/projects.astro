---
import Sidebar from '../components/Sidebar.astro';
import Layout from '../layouts/SubPageLayout.astro';
---

<Layout>
	<Sidebar />
	<div class="component">
		<div class="article">
			<div class="article-title">Projects</div>
			<div class="article-subtitle">A list of games in active development in order of precedence.</div>
			<div class="article-content">
				1. An advanced cleaning sim.
				<a href="/hazmat"> 
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"> 
						<path d="M15 10l5 5-5 5"></path> <path d="M4 4v7a4 4 0 004 4h12"></path> 
					</svg>
					Project Hazmat
				</a>

				2. An interactive horror expierience based on a reoccuring nightmare.
				<a href="/nightmare"> 
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"> 
						<path d="M15 10l5 5-5 5"></path> <path d="M4 4v7a4 4 0 004 4h12"></path> 
					</svg>
					Project Nightmare
				</a>

				3. A physics based action game.
				<a href="/gravput"> 
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"> 
						<path d="M15 10l5 5-5 5"></path> <path d="M4 4v7a4 4 0 004 4h12"></path> 
					</svg>
					Project GravPut
				</a>
			</div>
		</div>
	</div>
</Layout>